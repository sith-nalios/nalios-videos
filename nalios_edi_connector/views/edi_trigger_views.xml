<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="edi_trigger_view_form" model="ir.ui.view">
        <field name="name">edi.trigger.form</field>
        <field name="model">edi.trigger</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archivé" bg_color="bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="profile_id"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="trigger_type"/>
                            <field name="automation_id" readonly="1"/>
                        </group>
                    </group>
                    <group string="Filtres">
                        <field name="filter_domain"
                            placeholder="[('state', '=', 'sale')]"
                            help="Condition que le record doit satisfaire APRÈS l'action pour déclencher l'envoi"/>
                        <field name="filter_pre_domain"
                            placeholder="[('state', '!=', 'sale')]"
                            invisible="trigger_type == 'on_create'"
                            help="Condition que le record devait satisfaire AVANT la modification (pour détecter un changement d'état)"/>
                    </group>
                    <group string="Aide" col="1">
                        <div class="alert alert-info" role="alert">
                            <strong>Exemple SO confirmée :</strong> Trigger = "Création ou modification",
                            Condition après = <code>[('state', '=', 'sale')]</code>,
                            Condition avant = <code>[('state', '!=', 'sale')]</code>
                        </div>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="edi_trigger_view_list" model="ir.ui.view">
        <field name="name">edi.trigger.list</field>
        <field name="model">edi.trigger</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="profile_id"/>
                <field name="trigger_type"/>
                <field name="filter_domain"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_edi_trigger" model="ir.actions.act_window">
        <field name="name">Déclencheurs EDI</field>
        <field name="res_model">edi.trigger</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
