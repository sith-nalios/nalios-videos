<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="edi_channel_view_form" model="ir.ui.view">
        <field name="name">edi.channel.form</field>
        <field name="model">edi.channel</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <widget name="web_ribbon" title="Archivé" bg_color="bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="channel_type"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <group string="Webhook entrant (IN)" invisible="channel_type != 'webhook'">
                        <field name="token"/>
                        <field name="webhook_url" widget="CopyClipboardChar"/>
                        <button name="action_regenerate_token" type="object" string="Régénérer le token" class="btn-secondary"/>
                    </group>
                    <group string="Webhook sortant (OUT)" invisible="channel_type != 'webhook'">
                        <field name="remote_url" placeholder="https://api.client.com/edi/receive"/>
                        <field name="timeout"/>
                        <div>
                            <button name="action_test_connection" type="object" string="Tester la connexion" class="btn-secondary"/>
                        </div>
                    </group>
                    <group name="group_ftp" string="Connexion FTP/SFTP" invisible="channel_type not in ('ftp', 'sftp')">
                        <group>
                            <field name="host"/>
                            <field name="port"/>
                            <field name="timeout"/>
                        </group>
                        <group>
                            <field name="username"/>
                            <field name="password" password="True"/>
                        </group>
                        <group string="Dossiers">
                            <field name="remote_path" placeholder="/edi/in"/>
                            <field name="done_path" placeholder="/edi/done"/>
                        </group>
                        <group string="Fichiers sortants">
                            <field name="filename_template" placeholder="{sequence}"/>
                        </group>
                        <div>
                            <button name="action_test_connection" type="object" string="Tester la connexion" class="btn-secondary"/>
                            <button name="action_poll" type="object" string="Déclencher le polling" class="btn-secondary ms-2"/>
                        </div>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="edi_channel_view_list" model="ir.ui.view">
        <field name="name">edi.channel.list</field>
        <field name="model">edi.channel</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="channel_type"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_edi_channel" model="ir.actions.act_window">
        <field name="name">Canaux EDI</field>
        <field name="res_model">edi.channel</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
