<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_currency_rate_external_list" model="ir.ui.view">
        <field name="name">res.currency.rate.external.list</field>
        <field name="model">res.currency.rate.external</field>
        <field name="arch" type="xml">
            <list string="Taux de change externes">
                <field name="date"/>
                <field name="currency_id"/>
                <field name="rate"/>
            </list>
        </field>
    </record>

    <record id="view_currency_rate_external_form" model="ir.ui.view">
        <field name="name">res.currency.rate.external.form</field>
        <field name="model">res.currency.rate.external</field>
        <field name="arch" type="xml">
            <form string="Taux de change externe">
                <sheet>
                    <group>
                        <field name="currency_id"/>
                        <field name="rate"/>
                        <field name="date"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_currency_rate_external" model="ir.actions.act_window">
        <field name="name">Taux de change externes</field>
        <field name="res_model">res.currency.rate.external</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_sync_rates_server" model="ir.actions.server">
        <field name="name">Synchroniser les taux</field>
        <field name="model_id" ref="model_res_currency_rate_external"/>
        <field name="state">code</field>
        <field name="code">
env['res.currency.rate.external'].action_sync_rates()
action = {
    'type': 'ir.actions.act_window',
    'res_model': 'res.currency.rate.external',
    'view_mode': 'list,form',
    'name': 'Taux de change externes',
}
        </field>
    </record>

    <menuitem id="menu_currency_sync_root"
              name="Currency Sync"
              sequence="100"/>

    <menuitem id="menu_currency_rate_external"
              name="Taux de change"
              parent="menu_currency_sync_root"
              action="action_currency_rate_external"/>

    <menuitem id="menu_sync_rates"
              name="Synchroniser les taux"
              parent="menu_currency_sync_root"
              action="action_sync_rates_server"
              sequence="2"/>

</odoo>
