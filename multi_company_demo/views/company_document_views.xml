<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_company_document_list" model="ir.ui.view">
        <field name="name">company.document.list</field>
        <field name="model">company.document</field>
        <field name="arch" type="xml">
            <list string="Documents">
                <field name="name"/>
                <field name="company_id"/>
                <field name="date"/>
            </list>
        </field>
    </record>

    <record id="view_company_document_form" model="ir.ui.view">
        <field name="name">company.document.form</field>
        <field name="model">company.document</field>
        <field name="arch" type="xml">
            <form string="Document">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="company_id"/>
                        <field name="date"/>
                    </group>
                    <field name="content" placeholder="Contenu du document..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_company_document" model="ir.actions.act_window">
        <field name="name">Documents</field>
        <field name="res_model">company.document</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_multi_company_root"
              name="Multi-Company Demo"
              sequence="101"/>

    <menuitem id="menu_company_document"
              name="Documents"
              parent="menu_multi_company_root"
              action="action_company_document"/>

</odoo>
